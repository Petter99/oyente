{
  "manifest_version": 3,
  "name": "{{NOMBRE}} – Capturar pestaña",
  "short_name": "{{NOMBRE}}",
  "version": "{{VERSION}}",
  "description": "Envía el audio de la pestaña de tu clase a {{NOMBRE}} (en tu equipo) para transcribirla.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Transcribir esta pestaña con {{NOMBRE}}",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
